enum TransportType {
  train('髮ｻ霆・,   Icons.train),
  car('霆・,       Icons.directions_car),
  bus('繝舌せ',     Icons.directions_bus),
  bike('閾ｪ霆｢霆・,  Icons.pedal_bike),
  walk('蠕呈ｭｩ',    Icons.directions_walk),
  other('縺昴・莉・, Icons.more_horiz);

  const TransportType(this.label, this.icon);
  final String   label;
  final IconData icon;
}

